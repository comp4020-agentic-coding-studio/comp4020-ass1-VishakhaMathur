---
import "../styles/global.css";
import Battery from "../components/Battery.astro";
import Header from "../components/Header.astro";
import HighwayBump from "../components/HighwayBump.astro";
import HighwayCar from "../components/HighwayCar.astro";
import resistorIcon from "../components/resistor.png?url";
import { current, parallelResistance } from "../lib/circuit";

const VOLTAGE = 12;
const DEFAULT_RESISTANCE = 10;

// Comprehension check: an intentionally open circuit — no wire bridges the
// two rails — until the visitor drags both resistors across the same two
// rails, closing it with the resistors wired in parallel.
//
// Wiring convention deliberately matches the reference current-divider
// diagram in src/components/Rparallel.png: a left bus and a right bus, each
// drawn as ONE continuous vertical stroke, with the battery's entry wire
// meeting the left bus near its top and the return wire meeting the right
// bus near its bottom. There is no separate wire directly joining the two
// buses — the only path between them is through whichever branch(es) a
// resistor bridges — so the circuit can't accidentally short past the
// resistors.
const CHECK_VIEWBOX = { width: 460, height: 430 };
const CHECK_LEFT_X = 130;
const CHECK_RIGHT_X = 380;
const CHECK_BRANCH_Y = [90, 170];
const CHECK_BATTERY = { x: CHECK_LEFT_X, y: 260 };
const CHECK_BUS_TOP_Y = CHECK_BRANCH_Y[0];
const CHECK_ENTRY_Y = CHECK_BATTERY.y - 70; // battery's top lead end
const CHECK_RETURN_Y = CHECK_BATTERY.y + 70; // battery's bottom lead end, and the right bus's bottom

function pct(value: number, total: number): string {
  return `${(value / total) * 100}%`;
}

// The resistor icon's own leads already run to its left/right edges (see
// resistor.png), so sizing a tile to exactly the rail-to-rail span makes its
// leads land on the rails themselves instead of floating in the gap between
// them — the icon *is* the wire there, not a badge sitting on top of it.
const CHECK_SLOT_WIDTH_PCT = pct(CHECK_RIGHT_X - CHECK_LEFT_X, CHECK_VIEWBOX.width);
const CHECK_SLOT_CENTER_X_PCT = pct((CHECK_LEFT_X + CHECK_RIGHT_X) / 2, CHECK_VIEWBOX.width);

// Traces conventional current's path once the circuit is closed: out the
// battery's + lead, up the left bus, across both branches in parallel, down
// the right bus, and back along the return wire into the − lead. Each
// segment gets its own animated dashes (CSS, driven by .parallel-check's
// data-solved attribute) rather than one path covering the whole loop, so
// direction is just "start point -> end point" per segment instead of one
// long path string to reason about.
const CHECK_FLOW_SEGMENTS = [
  { x1: CHECK_LEFT_X, y1: CHECK_ENTRY_Y, x2: CHECK_LEFT_X, y2: CHECK_BUS_TOP_Y },
  ...CHECK_BRANCH_Y.map((y) => ({ x1: CHECK_LEFT_X, y1: y, x2: CHECK_RIGHT_X, y2: y })),
  { x1: CHECK_RIGHT_X, y1: CHECK_BUS_TOP_Y, x2: CHECK_RIGHT_X, y2: CHECK_RETURN_Y },
  { x1: CHECK_RIGHT_X, y1: CHECK_RETURN_Y, x2: CHECK_LEFT_X, y2: CHECK_RETURN_Y },
];

// Voltage-across-branches board: reuses the exact same closed 2-resistor
// layout as the resistance quiz/derivation boards above (same rails, same
// battery, same CHECK_* geometry) since the point here isn't a different
// circuit, it's the same one viewed through a voltmeter — both branches
// bridge the same two rails, so both read the battery's own voltage no
// matter what their resistance is; only the current (Ohm's law, V/R)
// differs per branch.
const VOLTAGE_CHECK_DEFAULT_VALUES = [DEFAULT_RESISTANCE, DEFAULT_RESISTANCE];

// Highway analogy: a speed bump stands in for a resistor (HighwayBump reuses
// a resistor body's own fill/stroke) and a car for current. Both boards
// share one viewBox so the same pct() math positions either lane layout.
const HIGHWAY_VIEWBOX = { width: 400, height: 160 };
const HIGHWAY_START_X = 30;
const HIGHWAY_FINISH_X = 370;
const HIGHWAY_SERIES_Y = 80;
const HIGHWAY_SERIES_BUMPS = [150, 250];
const HIGHWAY_PARALLEL_LANE_Y = [50, 130];
const HIGHWAY_PARALLEL_BUMP_X = 200;

// The "try it yourself" experiment: unlike every board above, the resistor
// count here is adjustable (up to EXPERIMENT_MAX_RESISTORS), so branch
// positions can't be a fixed 2-element array like CHECK_BRANCH_Y. Each
// branch gets a fixed vertical spacing below the last, and the bus/battery/
// return-line positions — and the SVG's own viewBox height — grow to fit,
// so the board never has to squeeze extra branches into a fixed space.
const EXPERIMENT_VIEWBOX_WIDTH = 460;
const EXPERIMENT_LEFT_X = 130;
const EXPERIMENT_RIGHT_X = 380;
const EXPERIMENT_BUS_TOP_Y = 90;
const EXPERIMENT_BRANCH_SPACING = 55;
const EXPERIMENT_MIN_RESISTORS = 1;
const EXPERIMENT_MAX_RESISTORS = 20;
const EXPERIMENT_DEFAULT_VALUES = [10, 10, 10];

function experimentBranchYsFor(n: number): number[] {
  return Array.from({ length: n }, (_, i) => EXPERIMENT_BUS_TOP_Y + i * EXPERIMENT_BRANCH_SPACING);
}

function experimentLayoutFor(n: number) {
  const branchYs = experimentBranchYsFor(n);
  const entryY = branchYs[branchYs.length - 1] + 40;
  const batteryY = entryY + 70;
  const returnY = batteryY + 70;
  const viewboxHeight = returnY + 40;
  return { branchYs, entryY, batteryY, returnY, viewboxHeight };
}

const experimentLayout = experimentLayoutFor(EXPERIMENT_DEFAULT_VALUES.length);
const experimentFlowSegments = [
  { x1: EXPERIMENT_LEFT_X, y1: experimentLayout.entryY, x2: EXPERIMENT_LEFT_X, y2: EXPERIMENT_BUS_TOP_Y },
  ...experimentLayout.branchYs.map((y) => ({ x1: EXPERIMENT_LEFT_X, y1: y, x2: EXPERIMENT_RIGHT_X, y2: y })),
  { x1: EXPERIMENT_RIGHT_X, y1: EXPERIMENT_BUS_TOP_Y, x2: EXPERIMENT_RIGHT_X, y2: experimentLayout.returnY },
  { x1: EXPERIMENT_RIGHT_X, y1: experimentLayout.returnY, x2: EXPERIMENT_LEFT_X, y2: experimentLayout.returnY },
];
const experimentInitialTotal = parallelResistance(EXPERIMENT_DEFAULT_VALUES);

// The "reach 7Ω" challenge: success matches the *displayed* total (rounded to
// one decimal), not a bit-exact float comparison — with three sliders, exact
// integer combinations are hard to land on by trial and error, so a visitor
// who drags to what the readout already shows as "7.0Ω" must see the
// checkmark, even if the underlying float is 6.98 or 7.02.
const EXPERIMENT_TARGET_OHMS = 7;
const EXPERIMENT_SUCCESS_EPSILON = 0.05;
const experimentIsInitialSuccess =
  Math.abs(experimentInitialTotal - EXPERIMENT_TARGET_OHMS) < EXPERIMENT_SUCCESS_EPSILON;

// The final challenge: a fixed (not adjustable) three-resistor board, reusing
// the experiment board's geometry helper since three branches is exactly what
// it already lays out. Values are chosen so every answer — Rtotal, Itotal,
// and each branch current — is a clean one-decimal number, so a visitor's
// typed answer can be checked against the same epsilon used above without
// the "6.98 reads as 7.0" ambiguity that motivated EXPERIMENT_SUCCESS_EPSILON.
const CHALLENGE_RESISTANCES = [6, 12, 4];
const CHALLENGE_VOLTAGE = VOLTAGE;
const challengeLayout = experimentLayoutFor(CHALLENGE_RESISTANCES.length);
const challengeFlowSegments = [
  { x1: EXPERIMENT_LEFT_X, y1: challengeLayout.entryY, x2: EXPERIMENT_LEFT_X, y2: EXPERIMENT_BUS_TOP_Y },
  ...challengeLayout.branchYs.map((y) => ({ x1: EXPERIMENT_LEFT_X, y1: y, x2: EXPERIMENT_RIGHT_X, y2: y })),
  { x1: EXPERIMENT_RIGHT_X, y1: EXPERIMENT_BUS_TOP_Y, x2: EXPERIMENT_RIGHT_X, y2: challengeLayout.returnY },
  { x1: EXPERIMENT_RIGHT_X, y1: challengeLayout.returnY, x2: EXPERIMENT_LEFT_X, y2: challengeLayout.returnY },
];
const CHALLENGE_TOTAL_RESISTANCE = parallelResistance(CHALLENGE_RESISTANCES);
const CHALLENGE_TOTAL_CURRENT = current(CHALLENGE_VOLTAGE, CHALLENGE_TOTAL_RESISTANCE);
const CHALLENGE_BRANCH_CURRENTS = CHALLENGE_RESISTANCES.map((r) => current(CHALLENGE_VOLTAGE, r));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Why more paths means less resistance</title>
    <script is:inline>
      // Runs before first paint so a returning dark-mode visitor never sees a
      // flash of the light theme. Kept separate from the bundled module
      // script below, which only runs after the DOM is parsed.
      if (localStorage.getItem("theme") === "dark") {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
  </head>
  <body>
    <Header homeHref="./" reviewHref="./review/" active="home">
      <h1 class="title">Resistors in Parallel</h1>
      <p class="definition" data-testid="parallel-definition">
        Two or more resistors are wired in parallel when each one connects across the very same pair
        of points — every resistor's leads land on the same two terminals as every other resistor in
        the group, so current gets more than one path to choose from.
      </p>
      {/* One master volume for every hum/tone below (Check your
          understanding, the highway analogy, the derivation) rather than a
          slider per section — it's the same "current flowing" sound
          language throughout, so one control covers all of it. */}
      <div class="sound-volume" data-testid="sound-volume-control">
        <label for="sound-volume-slider">Sound volume</label>
        <input type="range" id="sound-volume-slider" data-testid="sound-volume-slider" min="0" max="100" value="100" />
      </div>
    </Header>

    <section class="parallel-check" data-testid="parallel-check" aria-labelledby="parallel-check-title">
      <h2 class="parallel-check-title" id="parallel-check-title">Check your understanding</h2>
      <p class="parallel-check-instructions">
        The circuit below is open — no wire bridges the two rails yet. Drag both resistors onto the
        rails so each one connects across the same two points, closing the circuit with the
        resistors wired in parallel. (You can also focus a resistor with the keyboard and press
        Enter to connect or disconnect it.)
      </p>
      <div class="parallel-check-board" data-testid="parallel-check-board">
        <svg
          class="parallel-check-circuit"
          viewBox={`0 0 ${CHECK_VIEWBOX.width} ${CHECK_VIEWBOX.height}`}
          role="img"
          aria-label="An open circuit: a battery wired to a left bus and a right bus, with no resistor bridging them yet"
        >
          {/* Left bus: one continuous stroke from the top branch down into
              the battery's own top lead, so both branches' left ends and the
              battery's entry wire are visibly the same wire, not stitched
              pieces. */}
          <line
            x1={CHECK_LEFT_X}
            y1={CHECK_BUS_TOP_Y}
            x2={CHECK_LEFT_X}
            y2={CHECK_ENTRY_Y}
            stroke="#333"
            stroke-width="3"
          />
          {/* Right bus: same idea, continuous from the top branch down to
              where the return wire carries current back to the battery. */}
          <line
            x1={CHECK_RIGHT_X}
            y1={CHECK_BUS_TOP_Y}
            x2={CHECK_RIGHT_X}
            y2={CHECK_RETURN_Y}
            stroke="#333"
            stroke-width="3"
          />
          <line
            x1={CHECK_LEFT_X}
            y1={CHECK_RETURN_Y}
            x2={CHECK_RIGHT_X}
            y2={CHECK_RETURN_Y}
            stroke="#333"
            stroke-width="3"
          />
          {/* Solder-dot at each branch's junction with a bus, same convention
              as Branch.astro, so the wire visibly terminates on the bus
              instead of just stopping near it. */}
          {CHECK_BRANCH_Y.map((y) => (
            <>
              <circle cx={CHECK_LEFT_X} cy={y} r="4" fill="#333" />
              <circle cx={CHECK_RIGHT_X} cy={y} r="4" fill="#333" />
            </>
          ))}
          <Battery x={CHECK_BATTERY.x} y={CHECK_BATTERY.y} voltage={VOLTAGE} testid="parallel-check-battery" />
          {/* Hidden until .parallel-check[data-solved="true"] (see
              global.css) — only meaningful once both resistors are placed
              and current actually has a closed loop to flow around. */}
          <g class="current-flow" aria-hidden="true" data-testid="parallel-check-current-flow">
            {CHECK_FLOW_SEGMENTS.map((segment) => (
              <line
                x1={segment.x1}
                y1={segment.y1}
                x2={segment.x2}
                y2={segment.y2}
                class="current-flow-line"
              />
            ))}
          </g>
        </svg>
        {/* The visible wiring above is 100% SVG strokes now, for a seamless
            line with no join between differently-rendered pieces; these
            divs exist only as the rail-left/rail-right test hooks. */}
        <div
          class="parallel-check-rail"
          data-testid="parallel-check-rail-left"
          style={`left: ${pct(CHECK_LEFT_X, CHECK_VIEWBOX.width)}; top: ${pct(CHECK_BUS_TOP_Y, CHECK_VIEWBOX.height)}; height: ${pct(CHECK_ENTRY_Y - CHECK_BUS_TOP_Y, CHECK_VIEWBOX.height)};`}
        >
        </div>
        <div
          class="parallel-check-rail"
          data-testid="parallel-check-rail-right"
          style={`left: ${pct(CHECK_RIGHT_X, CHECK_VIEWBOX.width)}; top: ${pct(CHECK_BUS_TOP_Y, CHECK_VIEWBOX.height)}; height: ${pct(CHECK_RETURN_Y - CHECK_BUS_TOP_Y, CHECK_VIEWBOX.height)};`}
        >
        </div>
        {
          CHECK_BRANCH_Y.map((y, i) => (
            <div
              class="parallel-check-slot"
              data-testid={`parallel-check-slot-${i + 1}`}
              style={`left: ${pct(CHECK_LEFT_X, CHECK_VIEWBOX.width)}; top: ${pct(y, CHECK_VIEWBOX.height)}; width: ${CHECK_SLOT_WIDTH_PCT};`}
            />
          ))
        }
        <div
          class="parallel-check-tile"
          data-testid="parallel-check-resistor-1"
          style={`left: ${CHECK_SLOT_CENTER_X_PCT}; top: ${pct(370, CHECK_VIEWBOX.height)}; width: ${CHECK_SLOT_WIDTH_PCT};`}
          tabindex="0"
          role="button"
          aria-pressed="false"
          aria-label="Resistor R1"
        >
          <span class="parallel-check-tile-label" aria-hidden="true">R1</span>
          <img src={resistorIcon} alt="" />
        </div>
        <div
          class="parallel-check-tile"
          data-testid="parallel-check-resistor-2"
          style={`left: ${CHECK_SLOT_CENTER_X_PCT}; top: ${pct(400, CHECK_VIEWBOX.height)}; width: ${CHECK_SLOT_WIDTH_PCT};`}
          tabindex="0"
          role="button"
          aria-pressed="false"
          aria-label="Resistor R2"
        >
          <span class="parallel-check-tile-label" aria-hidden="true">R2</span>
          <img src={resistorIcon} alt="" />
        </div>
      </div>
      <div class="parallel-check-footer">
        <p class="parallel-check-feedback" data-testid="parallel-check-feedback" aria-live="polite">
          Drag both resistors onto the rails to close the circuit.
        </p>
        <button
          type="button"
          class="parallel-check-sound-toggle"
          data-testid="parallel-check-sound-toggle"
          aria-pressed="true"
        >
          Sound: on
        </button>
      </div>
    </section>

    <section
      class="parallel-check resistance-quiz"
      data-testid="resistance-quiz"
      aria-labelledby="resistance-quiz-title"
    >
      <h2 class="parallel-check-title" id="resistance-quiz-title">What happens to total resistance?</h2>
      <p class="parallel-check-instructions">
        R1 and R2 are both {DEFAULT_RESISTANCE}Ω, wired in parallel across the same two rails — the
        same circuit you just connected above. Compared to a single {DEFAULT_RESISTANCE}Ω resistor on
        its own, what happens to the total resistance? Take a guess: does it go up or down?
      </p>
      <div class="parallel-check-board resistance-quiz-board" data-testid="resistance-quiz-board">
        <svg
          class="parallel-check-circuit"
          data-testid="resistance-quiz-circuit"
          viewBox={`0 0 ${CHECK_VIEWBOX.width} ${CHECK_VIEWBOX.height}`}
          role="img"
          aria-label="A closed circuit: a battery wired to a left bus and a right bus, with two 10 ohm resistors bridging them in parallel"
        >
          <line
            x1={CHECK_LEFT_X}
            y1={CHECK_BUS_TOP_Y}
            x2={CHECK_LEFT_X}
            y2={CHECK_ENTRY_Y}
            stroke="#333"
            stroke-width="3"
          />
          <line
            x1={CHECK_RIGHT_X}
            y1={CHECK_BUS_TOP_Y}
            x2={CHECK_RIGHT_X}
            y2={CHECK_RETURN_Y}
            stroke="#333"
            stroke-width="3"
          />
          <line
            x1={CHECK_LEFT_X}
            y1={CHECK_RETURN_Y}
            x2={CHECK_RIGHT_X}
            y2={CHECK_RETURN_Y}
            stroke="#333"
            stroke-width="3"
          />
          {CHECK_BRANCH_Y.map((y) => (
            <>
              <circle cx={CHECK_LEFT_X} cy={y} r="4" fill="#333" />
              <circle cx={CHECK_RIGHT_X} cy={y} r="4" fill="#333" />
            </>
          ))}
          <Battery x={CHECK_BATTERY.x} y={CHECK_BATTERY.y} voltage={VOLTAGE} testid="resistance-quiz-battery" />
          {CHECK_BRANCH_Y.map((y, i) => (
            <g data-testid={`resistance-quiz-resistor-${i + 1}`}>
              <line x1={CHECK_LEFT_X} y1={y} x2={CHECK_LEFT_X + 60} y2={y} stroke="#333" stroke-width="3" />
              <rect
                x={CHECK_LEFT_X + 60}
                y={y - 14}
                width={CHECK_RIGHT_X - 60 - (CHECK_LEFT_X + 60)}
                height="28"
                rx="4"
                fill="#fff3cd"
                stroke="#e63946"
                stroke-width="2"
              />
              <text
                x={(CHECK_LEFT_X + CHECK_RIGHT_X) / 2}
                y={y + 5}
                text-anchor="middle"
                font-size="13"
                font-weight="600">R{i + 1}: {DEFAULT_RESISTANCE}Ω</text
              >
              <line x1={CHECK_RIGHT_X - 60} y1={y} x2={CHECK_RIGHT_X} y2={y} stroke="#333" stroke-width="3" />
            </g>
          ))}
        </svg>
      </div>
      <p class="predict-guess resistance-quiz-guess">
        <button type="button" data-testid="resistance-quiz-guess-increase">Increases</button>
        <button type="button" data-testid="resistance-quiz-guess-decrease">Decreases</button>
      </p>
      <div
        class="callout resistance-quiz-feedback"
        data-testid="resistance-quiz-feedback"
        aria-live="polite"
        {...{ hidden: true }}
      >
        <p>
          <strong data-testid="resistance-quiz-feedback-verdict"></strong>
        </p>
        <p>
          1/R<sub>total</sub> = 1/R1 + 1/R2 = 1/{DEFAULT_RESISTANCE} + 1/{DEFAULT_RESISTANCE} = 1/5, so
          R<sub>total</sub> = 5Ω — half of a single {DEFAULT_RESISTANCE}Ω resistor alone. Wiring a second
          resistor in parallel gives current a second path to flow through, and more available paths
          only ever make it easier for current to flow, so the combined resistance drops.
        </p>
      </div>
    </section>

    <section
      class="parallel-check highway-analogy"
      data-testid="highway-analogy"
      aria-labelledby="highway-analogy-title"
      {...{ hidden: true }}
    >
      <h2 class="parallel-check-title" id="highway-analogy-title">Why the total drops: a highway analogy</h2>
      <p class="parallel-check-instructions">
        Picture a speed bump as a resistor and a car as current. On the series road below, one car has
        to clear both {DEFAULT_RESISTANCE}Ω bumps back to back. On the parallel road, two cars each only
        have to clear one — the same {DEFAULT_RESISTANCE}Ω bump, but with a whole lane to themselves.
        Press Drive and watch which finishes first.
      </p>
      <div class="highway-boards">
        <div class="highway-board" data-testid="highway-series-board">
          <p class="highway-board-label">Series — one lane, two bumps</p>
          <div class="highway-board-scene">
            <svg
              class="highway-road"
              viewBox={`0 0 ${HIGHWAY_VIEWBOX.width} ${HIGHWAY_VIEWBOX.height}`}
              role="img"
              aria-label="A single lane with two speed bumps in a row"
            >
              <rect width={HIGHWAY_VIEWBOX.width} height={HIGHWAY_VIEWBOX.height} class="highway-shoulder" />
              <rect
                y={HIGHWAY_SERIES_Y - 30}
                width={HIGHWAY_VIEWBOX.width}
                height="60"
                class="highway-road-surface"
              />
              <line
                x1="0"
                y1={HIGHWAY_SERIES_Y}
                x2={HIGHWAY_VIEWBOX.width}
                y2={HIGHWAY_SERIES_Y}
                class="highway-lane-marking"
              />
              <line
                x1={HIGHWAY_START_X}
                y1={HIGHWAY_SERIES_Y - 30}
                x2={HIGHWAY_START_X}
                y2={HIGHWAY_SERIES_Y + 30}
                class="highway-start-line"
              />
              <line
                x1={HIGHWAY_FINISH_X}
                y1={HIGHWAY_SERIES_Y - 30}
                x2={HIGHWAY_FINISH_X}
                y2={HIGHWAY_SERIES_Y + 30}
                class="highway-finish-line"
              />
              <text x={HIGHWAY_START_X} y="18" text-anchor="middle" font-size="10" font-weight="600"
                >Start</text
              >
              <text x={HIGHWAY_FINISH_X} y="18" text-anchor="middle" font-size="10" font-weight="600"
                >Finish</text
              >
              {HIGHWAY_SERIES_BUMPS.map((x, i) => (
                <HighwayBump
                  x={x}
                  y={HIGHWAY_SERIES_Y}
                  resistanceOhms={DEFAULT_RESISTANCE}
                  testid={`highway-series-bump-${i + 1}`}
                />
              ))}
            </svg>
            <HighwayCar
              testid="highway-series-car"
              leftPct={pct(HIGHWAY_START_X, HIGHWAY_VIEWBOX.width)}
              topPct={pct(HIGHWAY_SERIES_Y, HIGHWAY_VIEWBOX.height)}
            />
          </div>
        </div>
        <div class="highway-board" data-testid="highway-parallel-board">
          <p class="highway-board-label">Parallel — two lanes, one bump each</p>
          <div class="highway-board-scene">
            <svg
              class="highway-road"
              viewBox={`0 0 ${HIGHWAY_VIEWBOX.width} ${HIGHWAY_VIEWBOX.height}`}
              role="img"
              aria-label="Two lanes side by side, each with one speed bump"
            >
              <rect width={HIGHWAY_VIEWBOX.width} height={HIGHWAY_VIEWBOX.height} class="highway-shoulder" />
              {HIGHWAY_PARALLEL_LANE_Y.map((y) => (
                <rect y={y - 25} width={HIGHWAY_VIEWBOX.width} height="50" class="highway-road-surface" />
              ))}
              <line
                x1="0"
                y1={(HIGHWAY_PARALLEL_LANE_Y[0] + HIGHWAY_PARALLEL_LANE_Y[1]) / 2}
                x2={HIGHWAY_VIEWBOX.width}
                y2={(HIGHWAY_PARALLEL_LANE_Y[0] + HIGHWAY_PARALLEL_LANE_Y[1]) / 2}
                class="highway-lane-marking"
              />
              <text x={HIGHWAY_START_X} y="14" text-anchor="middle" font-size="10" font-weight="600"
                >Start</text
              >
              <text x={HIGHWAY_FINISH_X} y="14" text-anchor="middle" font-size="10" font-weight="600"
                >Finish</text
              >
              {HIGHWAY_PARALLEL_LANE_Y.map((y, i) => (
                <>
                  <line
                    x1={HIGHWAY_START_X}
                    y1={y - 25}
                    x2={HIGHWAY_START_X}
                    y2={y + 25}
                    class="highway-start-line"
                  />
                  <line
                    x1={HIGHWAY_FINISH_X}
                    y1={y - 25}
                    x2={HIGHWAY_FINISH_X}
                    y2={y + 25}
                    class="highway-finish-line"
                  />
                  <HighwayBump
                    x={HIGHWAY_PARALLEL_BUMP_X}
                    y={y}
                    resistanceOhms={DEFAULT_RESISTANCE}
                    testid={`highway-parallel-bump-${i + 1}`}
                  />
                </>
              ))}
            </svg>
            {HIGHWAY_PARALLEL_LANE_Y.map((y, i) => (
              <HighwayCar
                testid={`highway-parallel-car-${i + 1}`}
