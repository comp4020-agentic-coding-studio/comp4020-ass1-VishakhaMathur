                <line
                  x1="332"
                  y1={CHECK_BRANCH_Y[1]}
                  x2="364"
                  y2={CHECK_BRANCH_Y[1]}
                  stroke="#f59e0b"
                  stroke-width="3"
                  marker-end="url(#derivation-arrow)"
                />
                <text
                  x="348"
