                      >
                      <line
                        x1={EXPERIMENT_RIGHT_X - 60}
                        y1={y}
                        x2={EXPERIMENT_RIGHT_X}
                        y2={y}
                        stroke="#333"
                        stroke-width="3"
                      />
                    </g>
                  </>
                ))}
              </g>
              <g aria-hidden="true" data-testid="challenge-current-flow">
                {challengeFlowSegments.map((segment) => (
                  <line
                    x1={segment.x1}
                    y1={segment.y1}
                    x2={segment.x2}
                    y2={segment.y2}
                    class="current-flow-line challenge-flow-line"
                  />
                ))}
              </g>
            </svg>
          </div>
        </div>
        <div class="experiment-controls challenge-controls" data-testid="challenge-controls">
          <div class="challenge-answer-rows">
            <div class="challenge-answer-row" data-testid="challenge-answer-total-resistance">
              <label for="challenge-input-total-resistance">Total resistance (Ω)</label>
              <input
                type="number"
                step="any"
                id="challenge-input-total-resistance"
                data-testid="challenge-input-total-resistance"
              />
              <span
                class="challenge-answer-mark"
                data-testid="challenge-mark-total-resistance"
                aria-hidden="true"
              ></span>
            </div>
            <div class="challenge-answer-row" data-testid="challenge-answer-total-current">
              <label for="challenge-input-total-current">Total current (A)</label>
              <input
                type="number"
                step="any"
                id="challenge-input-total-current"
                data-testid="challenge-input-total-current"
              />
              <span class="challenge-answer-mark" data-testid="challenge-mark-total-current" aria-hidden="true"
              ></span>
            </div>
            {CHALLENGE_RESISTANCES.map((_, i) => (
              <div class="challenge-answer-row" data-testid={`challenge-answer-i${i + 1}`}>
                <label for={`challenge-input-i${i + 1}`}>I{i + 1} (A)</label>
                <input
                  type="number"
                  step="any"
                  id={`challenge-input-i${i + 1}`}
                  data-testid={`challenge-input-i${i + 1}`}
                />
                <span class="challenge-answer-mark" data-testid={`challenge-mark-i${i + 1}`} aria-hidden="true"
                ></span>
              </div>
            ))}
          </div>
          <button type="button" class="challenge-check" data-testid="challenge-check">Check my answers</button>
          <div
            class="callout challenge-feedback"
            data-testid="challenge-feedback"
            aria-live="polite"
            {...{ hidden: true }}
          >
            <p>
              <strong data-testid="challenge-feedback-verdict"></strong>
            </p>
            <p>
              Worked solution: every branch shares {CHALLENGE_VOLTAGE}V, so 1/R<sub>total</sub> = 1/{
                CHALLENGE_RESISTANCES[0]
              } + 1/{CHALLENGE_RESISTANCES[1]} + 1/{CHALLENGE_RESISTANCES[2]}, giving R<sub>total</sub> = {
                CHALLENGE_TOTAL_RESISTANCE
              }Ω. Total current I = V/R<sub>total</sub> = {CHALLENGE_VOLTAGE}/{CHALLENGE_TOTAL_RESISTANCE} = {
                CHALLENGE_TOTAL_CURRENT
              }A. Each branch current is V/R: I1 = {CHALLENGE_VOLTAGE}/{CHALLENGE_RESISTANCES[0]} = {
                CHALLENGE_BRANCH_CURRENTS[0]
              }A, I2 = {CHALLENGE_VOLTAGE}/{CHALLENGE_RESISTANCES[1]} = {CHALLENGE_BRANCH_CURRENTS[1]}A, I3 = {
                CHALLENGE_VOLTAGE
              }/{CHALLENGE_RESISTANCES[2]} = {CHALLENGE_BRANCH_CURRENTS[2]}A — and I1 + I2 + I3 = {
                CHALLENGE_TOTAL_CURRENT
              }A, matching the total current above, just as Kirchhoff's current law says it must.
            </p>
          </div>
        </div>
      </div>
    </section>

    <script>
      import { current, parallelResistance, seriesResistance } from "../lib/circuit";

      // A single master volume (0-1) shared by every hum/tone on the page —
      // each sound system below multiplies its own base volume by this
      // before ramping a gain node. The refresh hooks let the slider retune
      // whichever hums are currently playing, instead of only taking effect
      // the next time a hum happens to restart.
      let masterVolume = 1;
      let checkHumRefresh: (() => void) | null = null;
      let derivationHumRefresh: (() => void) | null = null;
      let highwayHumRefresh: (() => void) | null = null;

      const volumeSlider = document.querySelector<HTMLInputElement>('[data-testid="sound-volume-slider"]');
      volumeSlider?.addEventListener("input", () => {
        masterVolume = Number(volumeSlider.value) / 100;
        checkHumRefresh?.();
        derivationHumRefresh?.();
        highwayHumRefresh?.();
      });

      // A comprehension check for the "same two points" definition of
      // parallel. Pointer Events (not the HTML5 drag-and-drop API) so this
      // works by touch as well as mouse.
      const checkBoard = document.querySelector<HTMLElement>('[data-testid="parallel-check-board"]');
      const checkSection = document.querySelector<HTMLElement>('[data-testid="parallel-check"]');
      const checkFeedback = document.querySelector<HTMLElement>('[data-testid="parallel-check-feedback"]');
      const checkSlots = [1, 2]
        .map((n) => document.querySelector<HTMLElement>(`[data-testid="parallel-check-slot-${n}"]`))
        .filter((el): el is HTMLElement => el !== null);
      const checkTiles = [1, 2]
        .map((n) => document.querySelector<HTMLElement>(`[data-testid="parallel-check-resistor-${n}"]`))
        .filter((el): el is HTMLElement => el !== null);
      const checkSoundToggle = document.querySelector<HTMLButtonElement>(
        '[data-testid="parallel-check-sound-toggle"]',
      );

      if (
        checkBoard &&
        checkSection &&
        checkFeedback &&
        checkSlots.length === 2 &&
        checkTiles.length === 2
      ) {
        const SNAP_DISTANCE_PX = 40;
        const restPosition = new Map<HTMLElement, { left: string; top: string }>();
        const tileSlot = new Map<HTMLElement, HTMLElement>();

        // A soft, continuous hum standing in for "current is flowing" —
        // built with the Web Audio API instead of an audio file, so there's
        // no asset to fetch or license. The oscillator is created once (on
        // the first user gesture, per browser autoplay rules) and then just
        // left running; connecting/disconnecting only ramps its gain up or
        // down, which avoids the click a raw start/stop would produce and
        // sidesteps that an AudioContext's start() can only ever be called
        // once per node.
        let soundEnabled = true;
        let audioCtx: AudioContext | null = null;
        let humGain: GainNode | null = null;
        const HUM_VOLUME = 0.2;
        const HUM_RAMP_SECONDS = 0.25;

        function ensureAudio() {
          if (audioCtx) return;
          const AudioContextCtor =
            window.AudioContext ?? (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
          if (!AudioContextCtor) return;
          audioCtx = new AudioContextCtor();
          const oscillator = audioCtx.createOscillator();
          oscillator.type = "sawtooth";
          oscillator.frequency.value = 180;
          humGain = audioCtx.createGain();
          humGain.gain.value = 0;
          oscillator.connect(humGain).connect(audioCtx.destination);
          oscillator.start();
        }

        // Browsers only let an AudioContext actually produce sound once it's
        // been resumed inside a trusted user-gesture handler — pointerdown
        // (the start of a drag) is the clearest, earliest such gesture on
        // this board, so the context is unlocked there rather than waiting
        // for the circuit to first become solved.
        function unlockAudio() {
          ensureAudio();
          if (audioCtx?.state === "suspended") void audioCtx.resume();
        }

        function setHumRunning(running: boolean) {
          if (!soundEnabled) return;
          unlockAudio();
          if (!audioCtx || !humGain) return;
          const target = running ? HUM_VOLUME * masterVolume : 0;
          humGain.gain.linearRampToValueAtTime(target, audioCtx.currentTime + HUM_RAMP_SECONDS);
        }

        checkTiles.forEach((tile) => {
          restPosition.set(tile, { left: tile.style.left, top: tile.style.top });
          tile.style.touchAction = "none";
        });

        function center(el: HTMLElement) {
          const rect = el.getBoundingClientRect();
          return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
        }

        // .parallel-check-tile is translate(-50%, -50%) in CSS, so its
        // left/top are the coordinates of its own center relative to the
        // board — no need to offset by half its width/height here.
        function placeAt(tile: HTMLElement, targetCenter: { x: number; y: number }) {
          const boardRect = checkBoard!.getBoundingClientRect();
          tile.style.left = `${targetCenter.x - boardRect.left}px`;
          tile.style.top = `${targetCenter.y - boardRect.top}px`;
        }

        // The hum is meant to confirm "current is flowing" while the visitor
        // is looking at *this* board — once they've scrolled on to the quiz,
        // highway, or derivation sections, a hum with no circuit in view just
        // reads as background noise. Paused (not disabled — the sound
        // toggle's own on/off preference is untouched) whenever the section
        // isn't on screen, and resumed automatically if they scroll back up
        // to a still-solved circuit.
        let checkSectionVisible = true;

        function refreshHum() {
          setHumRunning(checkSection!.dataset.solved === "true" && checkSectionVisible);
        }
        checkHumRefresh = refreshHum;

        function updateCheckFeedback() {
          const connectedCount = tileSlot.size;
          const solved = connectedCount === checkSlots.length;
          checkSection!.dataset.solved = String(solved);
          checkFeedback!.textContent =
            connectedCount === 0
              ? "Drag both resistors onto the rails to close the circuit."
              : connectedCount < checkSlots.length
                ? "One connected — place the second resistor across the same two rails."
                : "Closed! Both resistors connect across the same two points, so they're in parallel.";
          refreshHum();
        }

        new IntersectionObserver(([entry]) => {
          checkSectionVisible = entry.isIntersecting;
          refreshHum();
        }).observe(checkSection);

        checkSoundToggle?.addEventListener("click", () => {
          soundEnabled = !soundEnabled;
          checkSoundToggle.textContent = `Sound: ${soundEnabled ? "on" : "off"}`;
          checkSoundToggle.setAttribute("aria-pressed", String(soundEnabled));
          if (soundEnabled) {
            refreshHum();
          } else if (humGain && audioCtx) {
            humGain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + HUM_RAMP_SECONDS);
          }
        });

        function connectCheck(tile: HTMLElement, slot: HTMLElement) {
          tileSlot.set(tile, slot);
          tile.setAttribute("aria-pressed", "true");
          placeAt(tile, center(slot));
          updateCheckFeedback();
        }

        function disconnectCheck(tile: HTMLElement) {
          tileSlot.delete(tile);
          tile.setAttribute("aria-pressed", "false");
          const rest = restPosition.get(tile);
          if (rest) {
            tile.style.left = rest.left;
            tile.style.top = rest.top;
          }
          updateCheckFeedback();
        }

        function nearestEmptyCheckSlot(point: { x: number; y: number }): HTMLElement | null {
          let best: HTMLElement | null = null;
          let bestDistance = SNAP_DISTANCE_PX;
          for (const slot of checkSlots) {
            if ([...tileSlot.values()].includes(slot)) continue;
            const slotCenter = center(slot);
            const distance = Math.hypot(point.x - slotCenter.x, point.y - slotCenter.y);
            if (distance < bestDistance) {
              best = slot;
              bestDistance = distance;
            }
          }
          return best;
        }

        checkTiles.forEach((tile) => {
          let dragStart = { x: 0, y: 0 };
          let dragging = false;

          tile.addEventListener("pointerdown", (event) => {
            if (soundEnabled) unlockAudio();
            dragging = true;
            tile.setPointerCapture(event.pointerId);
            tile.classList.add("dragging");
            dragStart = { x: event.clientX, y: event.clientY };
            if (tileSlot.has(tile)) {
              tileSlot.delete(tile);
              tile.setAttribute("aria-pressed", "false");
            }
          });

          // Moved purely with a CSS transform (on top of the tile's own
          // translate(-50%, -50%)) instead of rewriting left/top every
          // event: transform is compositor-only, so the drag can't be
          // stalled by layout work elsewhere on the page. left/top are only
          // touched once, on drop, to commit the resting place.
          tile.addEventListener("pointermove", (event) => {
            if (!dragging) return;
            const dx = event.clientX - dragStart.x;
            const dy = event.clientY - dragStart.y;
            tile.style.transform = `translate(-50%, -50%) translate(${dx}px, ${dy}px)`;
          });

          tile.addEventListener("pointerup", () => {
            if (!dragging) return;
            dragging = false;
            tile.classList.remove("dragging");
            const dropCenter = center(tile);
            tile.style.transform = "";
            const slot = nearestEmptyCheckSlot(dropCenter);
            if (slot) connectCheck(tile, slot);
            else disconnectCheck(tile);
          });

          tile.addEventListener("keydown", (event) => {
            if (event.key !== "Enter" && event.key !== " ") return;
            event.preventDefault();
            if (tileSlot.has(tile)) {
              disconnectCheck(tile);
              return;
            }
            const emptySlot = checkSlots.find((slot) => ![...tileSlot.values()].includes(slot));
            if (emptySlot) connectCheck(tile, emptySlot);
          });
        });

        updateCheckFeedback();
      }

      // A second comprehension check, independent of the drag-to-connect
      // board above: asks for a prediction against the same closed
      // two-resistor parallel circuit, then reveals a verdict line (right or
      // wrong) followed by the same "why" explanation either way.
      const quizIncreaseBtn = document.querySelector<HTMLButtonElement>(
        '[data-testid="resistance-quiz-guess-increase"]',
      );
      const quizDecreaseBtn = document.querySelector<HTMLButtonElement>(
        '[data-testid="resistance-quiz-guess-decrease"]',
      );
      const quizFeedback = document.querySelector<HTMLElement>('[data-testid="resistance-quiz-feedback"]');
      const quizFeedbackVerdict = document.querySelector<HTMLElement>(
        '[data-testid="resistance-quiz-feedback-verdict"]',
      );
      // Declared here (rather than inside the highway block below) so
      // answerQuiz can reveal it the moment the visitor guesses — the
      // highway analogy is the "why" that follows the quiz's "what".
      const highwaySection = document.querySelector<HTMLElement>('[data-testid="highway-analogy"]');
      // Same reasoning: declared up here so the highway Drive button's click
      // handler (further down) can reveal it — voltage-check is the visual
      // premise ("both branches share a voltage") that the derivation's
      // first algebra step then states formally.
      const voltageCheckSection = document.querySelector<HTMLElement>('[data-testid="voltage-check"]');
      // Same reasoning: declared up here so the highway Drive button's click
      // handler (further down) can reveal it — the formal derivation is the
      // "how do we know" that follows the highway analogy's intuition.
      const derivationSection = document.querySelector<HTMLElement>('[data-testid="derivation"]');
      // Revealed by the same Drive click, right alongside the derivation —
      // "here's the proof" and "now go play with it" land at the same time.
      const experimentSection = document.querySelector<HTMLElement>('[data-testid="experiment"]');
      // Same reveal moment as the rest — the capstone challenge only makes
      // sense once the visitor has seen the voltage/derivation/experiment
      // sections it draws on.
      const challengeSection = document.querySelector<HTMLElement>('[data-testid="challenge"]');

      if (quizIncreaseBtn && quizDecreaseBtn && quizFeedback && quizFeedbackVerdict) {
        function answerQuiz(guess: "increase" | "decrease") {
          const correct = guess === "decrease";
          quizFeedbackVerdict!.textContent = correct
            ? "Yes, that's correct! Let's understand why:"
            : "No — it decreases. Let's understand why:";
          quizFeedback!.dataset.correct = String(correct);
          quizFeedback!.removeAttribute("hidden");
          quizIncreaseBtn!.disabled = true;
          quizDecreaseBtn!.disabled = true;
          highwaySection?.removeAttribute("hidden");
        }

        quizIncreaseBtn.addEventListener("click", () => answerQuiz("increase"));
        quizDecreaseBtn.addEventListener("click", () => answerQuiz("decrease"));
      }

      // Derivation section: the same "current is flowing" hum as Check your
      // understanding — this circuit is always closed once revealed (no
      // drag interaction to solve), so it just needs its own sound toggle
      // plus the same auto-pause-when-scrolled-out-of-view behaviour as the
      // section above.
      const derivationSoundToggle = document.querySelector<HTMLButtonElement>(
        '[data-testid="derivation-sound-toggle"]',
      );

      if (derivationSection && derivationSoundToggle) {
        let derivationSoundEnabled = true;
        let derivationAudioCtx: AudioContext | null = null;
        let derivationHumGain: GainNode | null = null;
        let derivationSectionVisible = true;
        const DERIVATION_HUM_VOLUME = 0.2;
        const DERIVATION_HUM_RAMP_SECONDS = 0.25;

        function ensureDerivationAudio() {
          if (derivationAudioCtx) return;
          const AudioContextCtor =
            window.AudioContext ??
            (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
          if (!AudioContextCtor) return;
          derivationAudioCtx = new AudioContextCtor();
          const oscillator = derivationAudioCtx.createOscillator();
          oscillator.type = "sawtooth";
          oscillator.frequency.value = 180;
          derivationHumGain = derivationAudioCtx.createGain();
          derivationHumGain.gain.value = 0;
          oscillator.connect(derivationHumGain).connect(derivationAudioCtx.destination);
          oscillator.start();
        }

        // Unlocked from the highway section's Drive click (the gesture that
        // reveals this section), same reasoning as unlockAudio/unlockHwAudio
        // above — an AudioContext can only start producing sound once
        // resumed inside a trusted user gesture.
        function unlockDerivationAudio() {
          ensureDerivationAudio();
          if (derivationAudioCtx?.state === "suspended") void derivationAudioCtx.resume();
        }

        function refreshDerivationHum() {
          if (!derivationSoundEnabled) return;
          unlockDerivationAudio();
          if (!derivationAudioCtx || !derivationHumGain) return;
          const running = !derivationSection!.hidden && derivationSectionVisible;
          const target = running ? DERIVATION_HUM_VOLUME * masterVolume : 0;
          derivationHumGain.gain.linearRampToValueAtTime(
            target,
            derivationAudioCtx.currentTime + DERIVATION_HUM_RAMP_SECONDS,
          );
        }
        derivationHumRefresh = refreshDerivationHum;

        // `isIntersecting` stays true for any nonzero overlap no matter what
        // threshold is passed, so a one-pixel sliver of this section left at
        // the top of the viewport would otherwise keep the hum playing once
        // the visitor has scrolled on to the experiment section below it.
        // Checking intersectionRatio directly against a real threshold means
        // the hum stops once this section is mostly scrolled past.
        new IntersectionObserver(
          ([entry]) => {
            derivationSectionVisible = entry.intersectionRatio >= 0.4;
            refreshDerivationHum();
          },
          { threshold: [0, 0.25, 0.4, 0.5, 0.75, 1] },
        ).observe(derivationSection);

        derivationSoundToggle.addEventListener("click", () => {
          derivationSoundEnabled = !derivationSoundEnabled;
          derivationSoundToggle.textContent = `Sound: ${derivationSoundEnabled ? "on" : "off"}`;
          derivationSoundToggle.setAttribute("aria-pressed", String(derivationSoundEnabled));
          if (derivationSoundEnabled) {
            refreshDerivationHum();
          } else if (derivationHumGain && derivationAudioCtx) {
            derivationHumGain.gain.linearRampToValueAtTime(
              0,
              derivationAudioCtx.currentTime + DERIVATION_HUM_RAMP_SECONDS,
            );
          }
        });
      }

      // Voltage-check sliders: fixed at exactly two branches (unlike the
      // experiment below), so a slider drag only ever patches that one
      // branch's own label and ammeter reading — no rebuild needed. The
      // voltmeter readings are never touched: they're the whole point, and
      // stay locked to VOLTAGE no matter what the sliders do.
      const VOLTAGE_CHECK_VOLTAGE = 12;

      [1, 2].forEach((n) => {
        const slider = document.querySelector<HTMLInputElement>(
          `[data-testid="voltage-check-resistor-${n}-slider"]`,
        );
        const valueLabel = document.querySelector<HTMLElement>(
          `[data-testid="voltage-check-resistor-${n}-value"]`,
        );
        const branchLabel = document.querySelector<SVGTextElement>(
          `[data-testid="voltage-check-resistor-${n}-label"]`,
        );
        const currentReadout = document.querySelector<HTMLElement>(
          `[data-testid="voltage-check-current-readout-${n}"] .voltage-check-current-value`,
        );

        slider?.addEventListener("input", () => {
          const value = Number(slider.value);
          const amps = current(VOLTAGE_CHECK_VOLTAGE, value).toFixed(2);
          if (valueLabel) valueLabel.textContent = `${value} Ω`;
          if (branchLabel) branchLabel.textContent = `R${n}: ${value}Ω`;
          if (currentReadout) currentReadout.textContent = `${amps}A`;
        });
      });

      // Resistor experiment: unlike every board above, the resistor count
      // here is adjustable, so its SVG branches and slider rows are rebuilt
      // from a plain `values` array whenever one is added or removed — the
      // same geometry math as EXPERIMENT_* in the frontmatter (duplicated
      // here for the same reason as HIGHWAY_*/HW_* below: the frontmatter
      // renders the real initial markup so it's testable as static HTML,
      // while this script owns rebuilding it after the initial render). A
      // slider drag alone never triggers a rebuild — it only patches that
      // one branch's label and the total — so dragging can't lose focus or
      // restart mid-gesture.
      const experimentCircuit = document.querySelector<SVGSVGElement>('[data-testid="experiment-circuit"]');
      const experimentFrameGroup = document.querySelector<SVGGElement>('[data-testid="experiment-frame"]');
      const experimentBranchesGroup = document.querySelector<SVGGElement>('[data-testid="experiment-branches"]');
      const experimentFlowGroup = document.querySelector<SVGGElement>(
        '[data-testid="experiment-current-flow"]',
      );
      const experimentRows = document.querySelector<HTMLElement>('[data-testid="experiment-resistor-rows"]');
      const experimentAddBtn = document.querySelector<HTMLButtonElement>(
        '[data-testid="experiment-add-resistor"]',
      );
      const experimentTotal = document.querySelector<HTMLElement>('[data-testid="experiment-total"]');
      const experimentCurrents = document.querySelector<HTMLElement>('[data-testid="experiment-currents"]');

      if (
        experimentCircuit &&
        experimentFrameGroup &&
        experimentBranchesGroup &&
        experimentFlowGroup &&
        experimentRows &&
        experimentAddBtn &&
        experimentTotal &&
        experimentCurrents
      ) {
        const EXP_VIEWBOX_WIDTH = 460;
        const EXP_LEFT_X = 130;
        const EXP_RIGHT_X = 380;
        const EXP_BUS_TOP_Y = 90;
        const EXP_BRANCH_SPACING = 55;
        const EXP_MIN_RESISTORS = 1;
        const EXP_MAX_RESISTORS = 20;
        const EXP_VOLTAGE = 12;
        const EXP_TARGET_OHMS = 7;
        const EXP_SUCCESS_EPSILON = 0.05;

        let values = [10, 10, 10];

        function expBranchYsFor(n: number): number[] {
          return Array.from({ length: n }, (_, i) => EXP_BUS_TOP_Y + i * EXP_BRANCH_SPACING);
        }

        function expLayoutFor(n: number) {
          const branchYs = expBranchYsFor(n);
          const entryY = branchYs[branchYs.length - 1] + 40;
          const batteryY = entryY + 70;
          const returnY = batteryY + 70;
          const viewboxHeight = returnY + 40;
          return { branchYs, entryY, batteryY, returnY, viewboxHeight };
        }

        function updateExperimentTotal() {
          const total = parallelResistance(values);
          const isSuccess = Math.abs(total - EXP_TARGET_OHMS) < EXP_SUCCESS_EPSILON;
          experimentTotal!.innerHTML = `Total resistance: <strong>${total.toFixed(1)}Ω</strong> <span class="experiment-success" data-testid="experiment-success"${isSuccess ? "" : " hidden"}>✓ Nice! You've made a ${EXP_TARGET_OHMS}Ω circuit.</span>`;
        }

        function experimentBranchMarkup(y: number, i: number, value: number): string {
          const midX = (EXP_LEFT_X + EXP_RIGHT_X) / 2;
          return `
            <circle cx="${EXP_LEFT_X}" cy="${y}" r="4" fill="#333" />
            <circle cx="${EXP_RIGHT_X}" cy="${y}" r="4" fill="#333" />
            <g data-testid="experiment-resistor-${i + 1}-branch">
              <line x1="${EXP_LEFT_X}" y1="${y}" x2="${EXP_LEFT_X + 60}" y2="${y}" stroke="#333" stroke-width="3" />
              <rect x="${EXP_LEFT_X + 60}" y="${y - 14}" width="${EXP_RIGHT_X - 60 - (EXP_LEFT_X + 60)}" height="28" rx="4" fill="#fff3cd" stroke="#e63946" stroke-width="2" />
              <text data-testid="experiment-resistor-${i + 1}-label" x="${midX}" y="${y - 20}" text-anchor="middle" font-size="13" font-weight="600">R${i + 1}: ${value}Ω</text>
              <line x1="${EXP_RIGHT_X - 60}" y1="${y}" x2="${EXP_RIGHT_X}" y2="${y}" stroke="#333" stroke-width="3" />
            </g>
          `;
        }

        function experimentBatteryMarkup(x: number, y: number, voltage: number): string {
          return `
            <g data-testid="experiment-battery" data-x="${x}" data-y="${y}" data-voltage="${voltage}">
              <line x1="${x}" y1="${y - 70}" x2="${x}" y2="${y - 45}" stroke="#333" stroke-width="3" />
              <rect x="${x - 25}" y="${y - 45}" width="50" height="90" rx="8" fill="#eef0ff" stroke="#4f46e5" stroke-width="2" />
              <text x="${x}" y="${y - 50}" text-anchor="middle" font-size="20" font-weight="bold" fill="#dc2626">+</text>
              <text x="${x}" y="${y + 4}" text-anchor="middle" font-size="14" font-weight="bold">${voltage}V</text>
              <text x="${x}" y="${y + 60}" text-anchor="middle" font-size="20" font-weight="bold" fill="#1e2230">−</text>
              <line x1="${x}" y1="${y + 45}" x2="${x}" y2="${y + 70}" stroke="#333" stroke-width="3" />
            </g>
          `;
        }

        function experimentFrameMarkup(layout: ReturnType<typeof expLayoutFor>): string {
          return `
            <line x1="${EXP_LEFT_X}" y1="${EXP_BUS_TOP_Y}" x2="${EXP_LEFT_X}" y2="${layout.entryY}" stroke="#333" stroke-width="3" />
            <line x1="${EXP_RIGHT_X}" y1="${EXP_BUS_TOP_Y}" x2="${EXP_RIGHT_X}" y2="${layout.returnY}" stroke="#333" stroke-width="3" />
            <line x1="${EXP_LEFT_X}" y1="${layout.returnY}" x2="${EXP_RIGHT_X}" y2="${layout.returnY}" stroke="#333" stroke-width="3" />
            ${experimentBatteryMarkup(EXP_LEFT_X, layout.batteryY, EXP_VOLTAGE)}
          `;
        }

        function experimentFlowMarkup(layout: ReturnType<typeof expLayoutFor>): string {
          const segments = [
            { x1: EXP_LEFT_X, y1: layout.entryY, x2: EXP_LEFT_X, y2: EXP_BUS_TOP_Y },
            ...layout.branchYs.map((y) => ({ x1: EXP_LEFT_X, y1: y, x2: EXP_RIGHT_X, y2: y })),
            { x1: EXP_RIGHT_X, y1: EXP_BUS_TOP_Y, x2: EXP_RIGHT_X, y2: layout.returnY },
            { x1: EXP_RIGHT_X, y1: layout.returnY, x2: EXP_LEFT_X, y2: layout.returnY },
          ];
          return segments
            .map(
              (segment) =>
                `<line x1="${segment.x1}" y1="${segment.y1}" x2="${segment.x2}" y2="${segment.y2}" class="current-flow-line experiment-flow-line" />`,
            )
            .join("");
        }

        function experimentRowMarkup(value: number, i: number, total: number): string {
          const removeDisabled = total <= EXP_MIN_RESISTORS ? "disabled" : "";
          return `
            <div class="experiment-resistor-row" data-testid="experiment-resistor-${i + 1}">
              <span class="experiment-resistor-row-label">R${i + 1}</span>
              <input type="range" min="1" max="100" step="1" value="${value}" data-testid="experiment-resistor-${i + 1}-slider" aria-label="Resistance of R${i + 1} in ohms" />
              <span class="experiment-resistor-row-value" data-testid="experiment-resistor-${i + 1}-value">${value} Ω</span>
              <button type="button" class="experiment-resistor-row-remove" data-testid="experiment-resistor-${i + 1}-remove" aria-label="Remove R${i + 1}" ${removeDisabled}>×</button>
            </div>
          `;
        }

        function experimentCurrentMarkup(value: number, i: number): string {
          const amps = current(EXP_VOLTAGE, value).toFixed(2);
          return `
            <p class="experiment-current" data-testid="experiment-current-readout-${i + 1}">
              <span class="experiment-current-label">I${i + 1}:</span>
              <span class="experiment-current-value">${amps}A</span>
            </p>
          `;
        }

        function attachExperimentRowListeners() {
          values.forEach((_, i) => {
            const slider = document.querySelector<HTMLInputElement>(
              `[data-testid="experiment-resistor-${i + 1}-slider"]`,
            );
            const valueLabel = document.querySelector<HTMLElement>(
              `[data-testid="experiment-resistor-${i + 1}-value"]`,
            );
            const branchLabel = document.querySelector<SVGTextElement>(
              `[data-testid="experiment-resistor-${i + 1}-label"]`,
            );
            const currentValue = document.querySelector<HTMLElement>(
              `[data-testid="experiment-current-readout-${i + 1}"] .experiment-current-value`,
            );
            const removeBtn = document.querySelector<HTMLButtonElement>(
              `[data-testid="experiment-resistor-${i + 1}-remove"]`,
            );

            slider?.addEventListener("input", () => {
              const value = Number(slider.value);
              values[i] = value;
              if (valueLabel) valueLabel.textContent = `${value} Ω`;
              if (branchLabel) branchLabel.textContent = `R${i + 1}: ${value}Ω`;
              if (currentValue) currentValue.textContent = `${current(EXP_VOLTAGE, value).toFixed(2)}A`;
              updateExperimentTotal();
            });

            removeBtn?.addEventListener("click", () => {
              if (values.length <= EXP_MIN_RESISTORS) return;
              values.splice(i, 1);
              renderExperiment();
            });
          });
        }

        function renderExperiment() {
          const layout = expLayoutFor(values.length);
          experimentCircuit!.setAttribute("viewBox", `0 0 ${EXP_VIEWBOX_WIDTH} ${layout.viewboxHeight}`);
          experimentFrameGroup!.innerHTML = experimentFrameMarkup(layout);
          experimentBranchesGroup!.innerHTML = layout.branchYs
            .map((y, i) => experimentBranchMarkup(y, i, values[i]))
            .join("");
          experimentFlowGroup!.innerHTML = experimentFlowMarkup(layout);
          experimentRows!.innerHTML = values.map((value, i) => experimentRowMarkup(value, i, values.length)).join("");
          experimentCurrents!.innerHTML = values.map((value, i) => experimentCurrentMarkup(value, i)).join("");
          attachExperimentRowListeners();
          experimentAddBtn!.disabled = values.length >= EXP_MAX_RESISTORS;
          updateExperimentTotal();
        }

        attachExperimentRowListeners();

        experimentAddBtn.addEventListener("click", () => {
          if (values.length >= EXP_MAX_RESISTORS) return;
          values.push(10);
          renderExperiment();
        });
      }

      const challengeCheckBtn = document.querySelector<HTMLButtonElement>('[data-testid="challenge-check"]');
      const challengeFeedback = document.querySelector<HTMLElement>('[data-testid="challenge-feedback"]');
      const challengeFeedbackVerdict = document.querySelector<HTMLElement>(
        '[data-testid="challenge-feedback-verdict"]',
      );

      if (challengeCheckBtn && challengeFeedback && challengeFeedbackVerdict) {
        // Kept in sync with CHALLENGE_RESISTANCES/CHALLENGE_VOLTAGE in the
        // frontmatter above — only the raw inputs are duplicated (as every
        // other section on this page does for its client script), the
        // correct-answer values themselves are computed here from the same
        // circuit.ts functions the frontmatter used, not hand-copied.
        const CHALLENGE_RESISTANCES = [6, 12, 4];
        const CHALLENGE_VOLTAGE = 12;
        const CHALLENGE_ANSWER_EPSILON = 0.05;

        const correctTotalResistance = parallelResistance(CHALLENGE_RESISTANCES);
        const correctTotalCurrent = current(CHALLENGE_VOLTAGE, correctTotalResistance);
        const correctBranchCurrents = CHALLENGE_RESISTANCES.map((r) => current(CHALLENGE_VOLTAGE, r));

        const challengeFields = [
          { testid: "total-resistance", correct: correctTotalResistance },
          { testid: "total-current", correct: correctTotalCurrent },
          ...correctBranchCurrents.map((correct, i) => ({ testid: `i${i + 1}`, correct })),
        ];

        challengeCheckBtn.addEventListener("click", () => {
          let correctCount = 0;

          for (const field of challengeFields) {
            const input = document.querySelector<HTMLInputElement>(
              `[data-testid="challenge-input-${field.testid}"]`,
            );
            const mark = document.querySelector<HTMLElement>(`[data-testid="challenge-mark-${field.testid}"]`);
            if (!input || !mark) continue;

            const isCorrect = Math.abs(Number(input.value) - field.correct) < CHALLENGE_ANSWER_EPSILON;
            if (isCorrect) correctCount++;
            mark.textContent = isCorrect ? "✓" : "✗";
            mark.classList.toggle("challenge-answer-mark-correct", isCorrect);
            mark.classList.toggle("challenge-answer-mark-incorrect", !isCorrect);
          }

          challengeFeedbackVerdict.textContent =
            correctCount === challengeFields.length
              ? `All ${challengeFields.length} correct!`
              : `${correctCount} of ${challengeFields.length} correct — check the marks above, then read the worked solution below.`;
          challengeFeedback.dataset.allCorrect = String(correctCount === challengeFields.length);
          challengeFeedback.removeAttribute("hidden");
        });
      }

      // The highway analogy: a speed bump slows a car the way a resistor
      // impedes current. One "Drive" button races all three cars at once —
      // the series car against both parallel cars — so the visitor sees
      // the parallel road finish sooner rather than just reading that it
      // does. Car position is driven frame-by-frame (not a CSS transition)
      // because speed needs to visibly dip near each bump.
      const highwayDriveBtn = document.querySelector<HTMLButtonElement>('[data-testid="highway-drive"]');
      const highwaySoundToggle = document.querySelector<HTMLButtonElement>(
        '[data-testid="highway-sound-toggle"]',
      );
      const highwayComparison = document.querySelector<HTMLElement>('[data-testid="highway-comparison"]');
      const highwayComparisonText = document.querySelector<HTMLElement>(
        '[data-testid="highway-comparison-text"]',
      );
      const highwaySeriesCar = document.querySelector<HTMLElement>('[data-testid="highway-series-car"]');
      const highwayParallelCar1 = document.querySelector<HTMLElement>('[data-testid="highway-parallel-car-1"]');
      const highwayParallelCar2 = document.querySelector<HTMLElement>('[data-testid="highway-parallel-car-2"]');

      if (
        highwaySection &&
        highwayDriveBtn &&
        highwaySoundToggle &&
        highwayComparison &&
        highwayComparisonText &&
        highwaySeriesCar &&
        highwayParallelCar1 &&
        highwayParallelCar2
      ) {
        const HW_VIEWBOX_WIDTH = 400;
        const HW_VIEWBOX_HEIGHT = 160;
        const HW_START_X = 30;
        const HW_FINISH_X = 370;
        const HW_SERIES_Y = 80;
        const HW_SERIES_BUMPS = [150, 250];
        const HW_PARALLEL_LANE_Y = [50, 130];
        const HW_PARALLEL_BUMP_X = 200;
        // How far (in viewBox units) a bump's slow-down reaches — wide
        // enough, at this base speed, that the dip is unmistakably visible
        // rather than a one-frame flicker.
        const HW_BUMP_INFLUENCE = 45;
        const HW_MIN_SPEED_FACTOR = 0.22;
        // The hump's own physical width (matches HighwayBump.astro's
        // HALF_WIDTH) — narrower than HW_BUMP_INFLUENCE, so the car only
        // visibly rises while its wheels are actually on the hump, not for
        // the whole (wider) zone where it's merely slowing down for it.
        const HW_BUMP_HALF_WIDTH = 22;
        const HW_BOUNCE_HEIGHT = 14;
        // A bump-free run takes ~2.5s at this base speed — slow on purpose,
        // so the slow-down at each bump reads clearly instead of the car
        // just zipping past.
        const HW_RUN_SECONDS_NO_BUMPS = 2.5;
        const HW_BASE_SPEED = (HW_FINISH_X - HW_START_X) / HW_RUN_SECONDS_NO_BUMPS;
        const HW_LOW_FREQ = 70;
        const HW_HIGH_FREQ = 160;
        const HW_HUM_VOLUME = 0.12;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function hwPct(x: number) {
          return `${(x / HW_VIEWBOX_WIDTH) * 100}%`;
        }

        function hwPctY(y: number) {
          return `${(y / HW_VIEWBOX_HEIGHT) * 100}%`;
        }

        // A smooth, raised-cosine dip: 1 right at the bump's centre, fading
        // to 0 at the edge of its influence radius, so the car eases into
        // and out of the slow-down instead of snapping.
        function speedFactor(x: number, bumps: number[]): number {
          let dip = 0;
          for (const bumpX of bumps) {
            const distance = Math.abs(x - bumpX);
            if (distance >= HW_BUMP_INFLUENCE) continue;
            dip = Math.max(dip, (1 + Math.cos((Math.PI * distance) / HW_BUMP_INFLUENCE)) / 2);
          }
          return 1 - dip * (1 - HW_MIN_SPEED_FACTOR);
        }

        // How far up (in viewBox units) the car should sit while riding over
        // a bump's hump, given its distance from the bump's centre — same
        // raised-cosine shape as speedFactor, but scoped to the hump's own
        // width so the "lift" tracks the drawn bump exactly: the car is back
        // on flat road the instant it's clear of it.
        function bumpRise(x: number, bumps: number[]): number {
          let rise = 0;
          for (const bumpX of bumps) {
            const distance = Math.abs(x - bumpX);
            if (distance >= HW_BUMP_HALF_WIDTH) continue;
            rise = Math.max(rise, ((1 + Math.cos((Math.PI * distance) / HW_BUMP_HALF_WIDTH)) / 2) * HW_BOUNCE_HEIGHT);
          }
          return rise;
        }

        interface HighwayCarState {
          el: HTMLElement;
          bumps: number[];
          baseY: number;
          x: number;
          elapsed: number;
          finished: boolean;
          crossed: Set<number>;
          oscillator: OscillatorNode | null;
          gain: GainNode | null;
        }

        function makeCarState(el: HTMLElement, bumps: number[], baseY: number): HighwayCarState {
          return {
            el,
            bumps,
            baseY,
            x: HW_START_X,
            elapsed: 0,
            finished: false,
            crossed: new Set(),
            oscillator: null,
            gain: null,
          };
        }

        const cars: HighwayCarState[] = [
          makeCarState(highwaySeriesCar, HW_SERIES_BUMPS, HW_SERIES_Y),
          makeCarState(highwayParallelCar1, [HW_PARALLEL_BUMP_X], HW_PARALLEL_LANE_Y[0]),
          makeCarState(highwayParallelCar2, [HW_PARALLEL_BUMP_X], HW_PARALLEL_LANE_Y[1]),
        ];
        const [seriesCar, parallelCar1, parallelCar2] = cars;

        // Same Web Audio idiom as the parallel-check hum above (lazy
        // AudioContext, unlocked on a user gesture, gain ramps instead of
        // clicky start/stop) but its own context: an engine hum per car
        // whose pitch tracks that car's speed, plus a one-shot "thump" the
        // instant a car crosses a bump's centre.
        let hwAudioCtx: AudioContext | null = null;
        let hwSoundEnabled = true;

        function ensureHwAudio() {
          if (hwAudioCtx) return;
          const AudioContextCtor =
            window.AudioContext ??
            (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
          if (!AudioContextCtor) return;
          hwAudioCtx = new AudioContextCtor();
        }

        function unlockHwAudio() {
          ensureHwAudio();
          if (hwAudioCtx?.state === "suspended") void hwAudioCtx.resume();
        }

        function startCarHum(car: HighwayCarState) {
          if (!hwAudioCtx || !hwSoundEnabled) return;
          const oscillator = hwAudioCtx.createOscillator();
          oscillator.type = "triangle";
          oscillator.frequency.value = HW_HIGH_FREQ;
          const gain = hwAudioCtx.createGain();
          gain.gain.value = 0;
          oscillator.connect(gain).connect(hwAudioCtx.destination);
          oscillator.start();
          gain.gain.linearRampToValueAtTime(HW_HUM_VOLUME * masterVolume, hwAudioCtx.currentTime + 0.15);
          car.oscillator = oscillator;
          car.gain = gain;
        }

        function stopCarHum(car: HighwayCarState) {
          if (!hwAudioCtx || !car.oscillator || !car.gain) return;
          const oscillator = car.oscillator;
          const gain = car.gain;
          gain.gain.linearRampToValueAtTime(0, hwAudioCtx.currentTime + 0.2);
          setTimeout(() => oscillator.stop(), 300);
          car.oscillator = null;
          car.gain = null;
        }

        // Lets the master volume slider retune cars that are already
        // driving, not just the next drive that starts.
        function refreshHighwayVolume() {
          if (!hwAudioCtx) return;
          for (const car of cars) {
            car.gain?.gain.setTargetAtTime(HW_HUM_VOLUME * masterVolume, hwAudioCtx.currentTime, 0.05);
          }
        }
        highwayHumRefresh = refreshHighwayVolume;

        function playBumpThump() {
          if (!hwAudioCtx || !hwSoundEnabled) return;
          const oscillator = hwAudioCtx.createOscillator();
          oscillator.type = "sine";
          oscillator.frequency.value = 90;
          const gain = hwAudioCtx.createGain();
          gain.gain.value = 0;
          oscillator.connect(gain).connect(hwAudioCtx.destination);
          oscillator.start();
          const now = hwAudioCtx.currentTime;
          gain.gain.linearRampToValueAtTime(0.4 * masterVolume, now + 0.02);
          gain.gain.linearRampToValueAtTime(0, now + 0.18);
          oscillator.stop(now + 0.2);
        }

        function resetCars() {
          for (const car of cars) {
            car.x = HW_START_X;
            car.elapsed = 0;
            car.finished = false;
            car.crossed.clear();
            car.el.style.left = hwPct(HW_START_X);
            car.el.style.top = hwPctY(car.baseY);
          }
        }

        // The 10Ω figure matches DEFAULT_RESISTANCE and the resistors drawn
        // on both boards above — reusing circuit.ts here keeps this number
        // anchored to the same math the quiz just taught, rather than a
        // second, disconnected constant.
        function showComparison() {
          const seriesOhms = seriesResistance([10, 10]);
          const parallelOhms = parallelResistance([10, 10]);
          const parallelElapsed = Math.max(parallelCar1.elapsed, parallelCar2.elapsed);
          highwayComparisonText!.textContent =
            `Series: ${seriesCar.elapsed.toFixed(1)}s to clear both bumps (${seriesOhms}Ω total). ` +
            `Parallel: ${parallelElapsed.toFixed(1)}s for both cars to get home (${parallelOhms}Ω total). ` +
            `More paths make it easier for current to flow, so the parallel trip finishes sooner even ` +
            `though every car covered the same distance.`;
          highwayComparison!.removeAttribute("hidden");
        }

        let hwAnimating = false;

        function driveHighway() {
          if (hwAnimating) return;
          hwAnimating = true;
          highwayDriveBtn!.disabled = true;
          highwayDriveBtn!.textContent = "Driving…";
          resetCars();
          if (hwSoundEnabled) {
            unlockHwAudio();
            for (const car of cars) startCarHum(car);
          }

          if (reduceMotion) {
            // No animation frames — jump straight to a result derived from
            // the same circuit math the rest of the page teaches, rather
            // than simulating per-frame motion nobody will see move.
            const seriesOhms = seriesResistance([10, 10]);
            const parallelOhms = parallelResistance([10, 10]);
            const SECONDS_PER_OHM = 0.12;
            seriesCar.elapsed = seriesOhms * SECONDS_PER_OHM;
            parallelCar1.elapsed = parallelOhms * SECONDS_PER_OHM;
            parallelCar2.elapsed = parallelOhms * SECONDS_PER_OHM;
            for (const car of cars) {
              car.el.style.left = hwPct(HW_FINISH_X);
              stopCarHum(car);
            }
            showComparison();
            hwAnimating = false;
            highwayDriveBtn!.disabled = false;
            highwayDriveBtn!.textContent = "Drive again";
            return;
          }

          let lastTime: number | null = null;

          function frame(time: number) {
            if (lastTime === null) lastTime = time;
            const dt = (time - lastTime) / 1000;
            lastTime = time;

            for (const car of cars) {
              if (car.finished) continue;
              const previousX = car.x;
              const factor = speedFactor(car.x, car.bumps);
              car.x = Math.min(HW_FINISH_X, car.x + HW_BASE_SPEED * factor * dt);
              car.elapsed += dt;
              car.el.style.left = hwPct(car.x);
              // Lift the car up over the hump as it crosses it, instead of
              // just gliding through at reduced speed — this is what makes
              // it read as driving *over* the bump, not past it.
              car.el.style.top = hwPctY(car.baseY - bumpRise(car.x, car.bumps));

              for (const bumpX of car.bumps) {
                if (!car.crossed.has(bumpX) && previousX < bumpX && car.x >= bumpX) {
                  car.crossed.add(bumpX);
                  playBumpThump();
                }
              }

              if (car.gain && car.oscillator && hwAudioCtx) {
                const targetFreq = HW_LOW_FREQ + (HW_HIGH_FREQ - HW_LOW_FREQ) * factor;
                car.oscillator.frequency.setTargetAtTime(targetFreq, hwAudioCtx.currentTime, 0.05);
              }

              if (car.x >= HW_FINISH_X) {
                car.finished = true;
                stopCarHum(car);
              }
            }

            if (cars.every((car) => car.finished)) {
              hwAnimating = false;
              highwayDriveBtn!.disabled = false;
              highwayDriveBtn!.textContent = "Drive again";
              showComparison();
              return;
            }

            requestAnimationFrame(frame);
          }

          requestAnimationFrame(frame);
        }

        highwayDriveBtn.addEventListener("click", () => {
          if (hwSoundEnabled) unlockHwAudio();
          driveHighway();
          voltageCheckSection?.removeAttribute("hidden");
          derivationSection?.removeAttribute("hidden");
          derivationHumRefresh?.();
          experimentSection?.removeAttribute("hidden");
          challengeSection?.removeAttribute("hidden");
        });

        highwaySoundToggle.addEventListener("click", () => {
          hwSoundEnabled = !hwSoundEnabled;
          highwaySoundToggle.textContent = `Sound: ${hwSoundEnabled ? "on" : "off"}`;
          highwaySoundToggle.setAttribute("aria-pressed", String(hwSoundEnabled));
          if (!hwSoundEnabled) {
            for (const car of cars) stopCarHum(car);
          }
        });
      }
    </script>
  </body>
</html>
