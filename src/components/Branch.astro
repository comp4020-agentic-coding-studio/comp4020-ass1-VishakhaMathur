---
// A single parallel path between the left and right bus bars: wire, switch,
// resistor, wire. The switch and resistor label are static markup here — the
// page script toggles which switch state is visible and rewrites the label
// text as the corresponding slider/button change.
interface Props {
  x1: number;
  x2: number;
  y: number;
  resistanceOhms: number;
  testid: string;
}

const { x1, x2, y, resistanceOhms, testid } = Astro.props;
const wireLeftEnd = x1 + 60;
const switchEnd = x1 + 120;
const resistorEnd = x2 - 60;
---

<g data-testid={testid} data-x1={x1} data-x2={x2} data-y={y} data-resistance={resistanceOhms} class="branch">
  <line x1={x1} y1={y} x2={wireLeftEnd} y2={y} stroke="#333" stroke-width="3" />
  <circle cx={wireLeftEnd} cy={y} r="3" fill="#333" />
  <line
    data-testid={`${testid}-switch-closed`}
    x1={wireLeftEnd}
    y1={y}
    x2={switchEnd}
    y2={y}
    stroke="#333"
    stroke-width="3"
  />
  <g data-testid={`${testid}-switch-open`} {...{ hidden: true }}>
    <line x1={wireLeftEnd} y1={y} x2={wireLeftEnd + 40} y2={y - 18} stroke="#333" stroke-width="3" />
  </g>
  <circle cx={switchEnd} cy={y} r="3" fill="#333" />
  <rect
    data-testid={`${testid}-resistor`}
    x={switchEnd}
    y={y - 14}
    width={resistorEnd - switchEnd}
    height="28"
    rx="4"
    fill="#fff3cd"
    stroke="#e63946"
    stroke-width="2"
  />
  <text
    data-testid={`${testid}-label`}
    x={(switchEnd + resistorEnd) / 2}
    y={y + 5}
    text-anchor="middle"
    font-size="13"
    font-weight="600">{resistanceOhms}Ω</text
  >
  <line x1={resistorEnd} y1={y} x2={x2} y2={y} stroke="#333" stroke-width="3" />
</g>

<style>
  .branch {
    transition: opacity 0.15s ease;
  }

  .branch.off {
    opacity: 0.35;
  }
</style>
