---
interface Props {
  x: number;
  y: number;
  mirrorAngleDeg: number;
  length?: number;
  testid?: string;
}

const { x, y, mirrorAngleDeg, length = 80, testid = "normal-line" } = Astro.props;

// The normal is perpendicular to the mirror surface, drawn through the point
// of incidence and extending equally to both sides of it.
const normalAngleRad = ((mirrorAngleDeg + 90) * Math.PI) / 180;
const dx = (Math.cos(normalAngleRad) * length) / 2;
const dy = (Math.sin(normalAngleRad) * length) / 2;
const x1 = x - dx;
const y1 = y - dy;
const x2 = x + dx;
const y2 = y + dy;
---

<g data-testid={testid} data-x={x} data-y={y} data-mirror-angle-deg={mirrorAngleDeg}>
  <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#9aa0a6" stroke-width="1.5" stroke-dasharray="4 4" />
</g>
