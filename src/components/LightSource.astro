---
interface Props {
  x: number;
  y: number;
  radius?: number;
  testid?: string;
}

const { x, y, radius = 14, testid = "light-source" } = Astro.props;
const glowId = `light-glow-${testid}`;
---

<g
  data-testid={testid}
  data-x={x}
  data-y={y}
  transform={`translate(${x}, ${y})`}
  class="light-source"
  tabindex="0"
  role="slider"
  aria-label="Light source, drag to aim"
>
  <defs>
    <radialGradient id={glowId} cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fff9c4" stop-opacity="0.95" />
      <stop offset="45%" stop-color="#ffe066" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#ffe066" stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="0" cy="0" r={radius * 3} fill={`url(#${glowId})`} />
  <circle cx="0" cy="0" r={radius} fill="#fff3b0" stroke="#e6b800" stroke-width="1.5" />
  <circle cx="0" cy="0" r={radius * 0.4} fill="#fffde7" />
</g>

<style>
  .light-source {
    cursor: grab;
  }

  .light-source:active {
    cursor: grabbing;
  }
</style>
