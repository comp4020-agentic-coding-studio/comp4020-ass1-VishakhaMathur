---
interface Props {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  color?: string;
  dashed?: boolean;
  testid: string;
}

const { x1, y1, x2, y2, color = "#ff6b35", dashed = false, testid } = Astro.props;
const angleDeg = (Math.atan2(y2 - y1, x2 - x1) * 180) / Math.PI;
const markerId = `arrow-${testid}`;
---

<g data-testid={testid} data-x1={x1} data-y1={y1} data-x2={x2} data-y2={y2} data-angle-deg={angleDeg}>
  <defs>
    <marker
      id={markerId}
      viewBox="0 0 10 10"
      refX="8"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" fill={color} />
    </marker>
  </defs>
  <line
    x1={x1}
    y1={y1}
    x2={x2}
    y2={y2}
    stroke={color}
    stroke-width="2.5"
    stroke-dasharray={dashed ? "6 4" : undefined}
    marker-end={`url(#${markerId})`}
  />
</g>
