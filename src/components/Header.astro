---
// The in-page section nav (jump links, not a multi-page nav — this is a
// single scrolling page, review included).
//
// Also the single shared place to load the display/body serif fonts used by
// .title/.definition et al in global.css, so index.astro doesn't import them
// itself.
import "@fontsource-variable/fraunces";
import "@fontsource/source-serif-4";
---

<header class="site-header">
  <div class="site-header-bar">
    <nav class="section-nav" aria-label="Sections">
      <a href="#parallel-check-title">Understand</a>
      <a href="#resistance-quiz-title">Quiz</a>
      <a href="#highway-analogy-title">Highway</a>
      <a href="#voltage-check-title">Voltage</a>
      <a href="#derivation-title">Derivation</a>
      <a href="#experiment-title">Experiment</a>
      <a href="#review-title">Review</a>
    </nav>
  </div>
  <slot />
</header>
