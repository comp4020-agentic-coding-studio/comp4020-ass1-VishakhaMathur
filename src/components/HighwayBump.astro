---
// A single speed breaker sitting on a highway's road line, drawn with the
// same fill/stroke as a resistor body (Branch.astro's rect) so the "bump
// slows the car down like a resistor slows current" comparison reads
// visually, not just in the surrounding copy. The hazard-stripe band and Ω
// label are layered on top of that same silhouette rather than replacing
// it, so the resistor comparison and the real-speed-bump look coexist.
interface Props {
  x: number;
  y: number;
  resistanceOhms: number;
  testid: string;
}

const { x, y, resistanceOhms, testid } = Astro.props;
const HALF_WIDTH = 22;
const HEIGHT = 15;
// SVG ids must be unique per document, and this component renders multiple
// times per page — derive one from testid rather than hardcoding a name.
const uid = testid.replace(/[^a-zA-Z0-9_-]/g, "");
const stripesId = `hw-bump-stripes-${uid}`;
const clipId = `hw-bump-clip-${uid}`;
const bumpPath = `M ${x - HALF_WIDTH} ${y} Q ${x} ${y - HEIGHT} ${x + HALF_WIDTH} ${y} Z`;
---

<g data-testid={testid}>
  <defs>
    <pattern id={stripesId} width="6" height="6" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
      <rect width="6" height="6" fill="#1e2230" />
      <rect width="3" height="6" fill="#fbbf24" />
    </pattern>
    <clipPath id={clipId}>
      <path d={bumpPath} />
    </clipPath>
  </defs>
  {/* Soft ground shadow so the bump reads as raised off the road surface,
      not painted flat onto it. */}
  <ellipse cx={x} cy={y + 2} rx={HALF_WIDTH + 2} ry="3.5" fill="#000" opacity="0.15" />
  <path d={bumpPath} fill="#fff3cd" stroke="#e63946" stroke-width="2" />
  {/* Hazard-stripe band across the crest — clipped to the bump's own
      silhouette so the stripes read as painted onto the hump, the way real
      speed-bump markings are, rather than floating over it. */}
  <rect
    x={x - HALF_WIDTH}
    y={y - HEIGHT}
    width={HALF_WIDTH * 2}
    height={HEIGHT}
    fill={`url(#${stripesId})`}
    clip-path={`url(#${clipId})`}
    opacity="0.55"
  />
  <text x={x} y={y + 15} text-anchor="middle" font-size="11" font-weight="700" fill="#e63946"
    >{resistanceOhms}Ω</text
  >
</g>
